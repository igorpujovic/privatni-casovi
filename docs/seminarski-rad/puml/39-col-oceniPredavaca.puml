@startuml
!include style.iuml
skinparam maxMessageSize 240

title Kolaboracioni dijagram — oceniPredavaca()
hide empty members
skinparam nodesep 55
skinparam ranksep 60
object ":Učenik" as A
object ":OcenaController" as C
object ":KorisnikRepository" as KR
object ":OcenaRepository" as OCR
object ":Ocena" as O
object ":ApplicationDbContext" as CTX
object "PrivatniCasovi : MS SQL" as DB

A --> C : 1: Oceni(model)
C --> KR : 2: PredavacAsync(model.PredavacId)
KR --> DB : 3: SELECT AspNetUsers
C --> C : 4: ModelState.IsValid
C --> OCR : 5: PostojecaAsync(ucenikId, predavacId)
OCR --> DB : 6: SELECT nad Ocene
C --> O : 7: create(...) ili setVrednost(vrednost)
C --> OCR : 8: Add(ocena) ili Update(ocena)
OCR --> CTX : 9: Ocene.Add / Ocene.Update
C --> OCR : 10: SaveChangesAsync()
OCR --> CTX : 11: SaveChangesAsync()
CTX --> DB : 12: INSERT ili UPDATE nad Ocene

@enduml
