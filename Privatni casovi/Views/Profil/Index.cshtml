@model ProfilViewModel
@{
    ViewData["Title"] = "Moj profil";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-4">Moj profil</h1>

        @if (TempData["Poruka"] != null)
        {
            <div class="alert alert-success">@TempData["Poruka"]</div>
        }

        @* enctype is what makes the file part of the POST at all — without it the browser
           sends the file's name and nothing else, and the upload silently does nothing. *@
        <form asp-action="Index" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-4">
                <div class="col-sm-4 text-center">
                    @* The photo an učenik sees on your oglasi and on your profil. *@
                    <img src="@Fotografija.Putanja(Model.TrenutnaSlika)"
                         alt="Fotografija predavača"
                         class="img-fluid rounded border mb-3" />

                    <div class="mb-3 text-start">
                        <label asp-for="Slika" class="form-label"></label>
                        <input asp-for="Slika" type="file" class="form-control"
                               accept="@Fotografija.FilterZaIzbor" />
                        <span asp-validation-for="Slika" class="text-danger"></span>
                        <div class="form-text">
                            @Fotografija.DozvoljeniTipovi, najviše @Fotografija.NajvecaVelicinaMb MB.
                            Ostavite prazno da zadržite postojeću fotografiju.
                        </div>
                    </div>
                </div>

                <div class="col-sm-8">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" value="@Model.Email" readonly />
                        <div class="form-text">
                            Email je vaše korisničko ime za prijavu i ne menja se ovde.
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Ime" class="form-label"></label>
                            <input asp-for="Ime" class="form-control" />
                            <span asp-validation-for="Ime" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Prezime" class="form-label"></label>
                            <input asp-for="Prezime" class="form-control" />
                            <span asp-validation-for="Prezime" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefon" class="form-label"></label>
                        <input asp-for="Telefon" class="form-control" />
                        <span asp-validation-for="Telefon" class="text-danger"></span>
                        <div class="form-text">
                            Učenici vas kontaktiraju direktno na ovaj broj — platforma nema
                            svoje poruke.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Biografija" class="form-label"></label>
                        <textarea asp-for="Biografija" class="form-control" rows="6"
                                  maxlength="1000"></textarea>
                        <span asp-validation-for="Biografija" class="text-danger"></span>
                        <div class="form-text">
                            Šta predajete, koliko dugo i kome — ovo učenik čita na vašem profilu.
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Sačuvaj</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
