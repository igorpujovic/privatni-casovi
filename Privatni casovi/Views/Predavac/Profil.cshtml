@model ProfilPredavacaViewModel
@{
    var predavac = Model.Predavac;
    ViewData["Title"] = $"{predavac.Ime} {predavac.Prezime}";
}

@* The public profil of one predavač, reached from an oglas. Everything here is read-only:
   the foto, biografija and kontakt podaci are what "Moj profil" writes, and the oglasi are
   the visible ones — a withdrawn oglas belongs on its own predavač's "Moji oglasi" and
   nowhere else. *@

@* Ocenjivanje and the Omiljeni toggle both redirect back here, so this is where their
   outcome is read. *@
@if (TempData["Poruka"] != null)
{
    <div class="alert alert-success">@TempData["Poruka"]</div>
}

@if (TempData["Greska"] != null)
{
    <div class="alert alert-danger">@TempData["Greska"]</div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                @* The same img-fluid-in-a-column the other three screens render a photo with,
                   rather than a sized box: what a predavač uploaded is whatever shape it is. *@
                <div class="row align-items-center g-3">
                    <div class="col-4 col-lg-12 mb-lg-3">
                        <img src="@Fotografija.Putanja(predavac.SlikaFajl)"
                             alt="Fotografija predavača"
                             class="img-fluid rounded border" />
                    </div>

                    <div class="col-8 col-lg-12">
                        <h1 class="h4 mb-1">@predavac.Ime @predavac.Prezime</h1>

                        @* PrikazOcene, the same helper the pretraga card and the oglas page
                           call — an unrated predavač reads "Nema ocena", muted, never 0,00. *@
                        <div class="@PrikazOcene.Klasa(Model.ProsecnaOcena)">
                            @PrikazOcene.Tekst(Model.ProsecnaOcena, Model.BrojOcena)
                        </div>
                    </div>
                </div>

                @* The handoff, and the same one the oglas page and the omiljeni list show —
                   one partial, so the three screens cannot spell it differently. *@
                <div class="mt-3">
                    <partial name="_KontaktPodaci" model="predavac" />
                </div>

                @* Everything below is for učenici only, and both of them post to a controller
                   that is [Authorize(Roles = Uloge.Ucenik)] — this check decides what is
                   drawn, those attributes decide what is accepted, and hiding a form is not
                   what stops a predavač from rating or marking. *@
                @if (User.IsInRole(Uloge.Ucenik))
                {
                    <hr class="my-3" />

                    @* One toggle, posting to whichever of the two actions this state calls
                       for — a single button that reads what it is about to do, rather than an
                       "add" and a "remove" sitting side by side with one of them inert.
                       Pressing it twice writes one row and then no row: the repository checks
                       before it inserts, so this cannot become a duplicate. *@
                    <form asp-controller="Omiljeni"
                          asp-action="@(Model.JeOmiljeni ? "Ukloni" : "Dodaj")" method="post">
                        <input type="hidden" name="predavacId" value="@predavac.Id" />

                        <button type="submit"
                                class="btn w-100 @(Model.JeOmiljeni ? "btn-outline-danger" : "btn-outline-primary")">
                            @(Model.JeOmiljeni ? "Ukloni iz omiljenih" : "Dodaj u omiljene")
                        </button>
                    </form>

                    @* Said out loud, because a predavač reading their own profil sees no
                       button and no count, and an učenik has no way of knowing that from
                       the button alone. *@
                    <div class="form-text">Omiljene vidite samo vi.</div>

                    <hr class="my-3" />

                    <form asp-controller="Ocena" asp-action="Oceni" method="post">
                        <input type="hidden" name="PredavacId" value="@predavac.Id" />

                        <label class="form-label fw-semibold" for="Vrednost">Vaša ocena</label>

                        <div class="row g-2">
                            <div class="col-7 col-sm-8 col-lg-7">
                                @* No asp-for: the page's model is the profil, not the form's
                                   view model, so the name is written out to match
                                   OcenaFormViewModel.Vrednost. *@
                                <select class="form-select" id="Vrednost" name="Vrednost" required>
                                    @* Selected when they have not rated yet, so the select
                                       opens on nothing rather than pre-choosing a 5 the
                                       učenik never picked. *@
                                    <option value="" selected="@(Model.MojaOcena is null)">Izaberite…</option>

                                    @for (var vrednost = 5; vrednost >= 1; vrednost--)
                                    {
                                        <option value="@vrednost" selected="@(Model.MojaOcena == vrednost)">@vrednost</option>
                                    }
                                </select>
                            </div>

                            <div class="col-5 col-sm-4 col-lg-5">
                                <button type="submit" class="btn btn-primary w-100">
                                    @(Model.MojaOcena is null ? "Oceni" : "Izmeni")
                                </button>
                            </div>
                        </div>

                        @* Said out loud, because a pre-filled select does not by itself
                           explain that submitting again replaces the ocena rather than
                           adding one. *@
                        <div class="form-text">
                            @(Model.MojaOcena is null
                                ? "Ocenu možete kasnije izmeniti."
                                : "Već ste ocenili ovog predavača — slanjem menjate postojeću ocenu.")
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <section class="mb-4">
            <h2 class="h5">Biografija</h2>

            @if (string.IsNullOrWhiteSpace(predavac.Biografija))
            {
                @* Said rather than left blank: an empty heading reads as a page that failed
                   to load. Nothing is wrong — a biografija is optional on "Moj profil". *@
                <p class="text-muted mb-0">Nema biografije.</p>
            }
            else
            {
                @* The predavač's own words, with the line breaks they typed. Razor still
                   encodes the text — the same rule a dostupnost is rendered under. *@
                <p class="mb-0" style="white-space: pre-line">@predavac.Biografija</p>
            }
        </section>

        <section>
            <h2 class="h5">Oglasi</h2>

            @if (Model.Oglasi.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    Ovaj predavač trenutno nema objavljenih oglasa.
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    @foreach (var oglas in Model.Oglasi)
                    {
                        <div class="col">
                            <div class="card card-oglas h-100">
                                <div class="card-body d-flex flex-column">
                                    <h3 class="h6 card-title mb-1">@oglas.Predmet?.Naziv</h3>
                                    <p class="text-muted small mb-2">@oglas.Predmet?.Oblast?.Naziv</p>

                                    <p class="fs-5 fw-semibold mb-2">
                                        @oglas.CenaCasa.ToString("N2") RSD
                                        <span class="fs-6 fw-normal text-muted">po času</span>
                                    </p>

                                    @* Pushed down so the badge sits level across a row of
                                       cards whose predmet names wrap differently. *@
                                    <p class="mt-auto mb-0">
                                        <span class="badge bg-light text-dark border">@Html.DisplayFor(_ => oglas.Lokacija)</span>
                                    </p>

                                    @* The whole card is the link, the same one anchor per
                                       card the pretraga grid uses — the predavač's name is
                                       not repeated on it, because this is their own page. *@
                                    <a asp-controller="Oglas" asp-action="Detalji" asp-route-id="@oglas.Id"
                                       class="stretched-link" aria-label="Detalji oglasa: @oglas.Predmet?.Naziv"></a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>
